{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RTMP File Streamer",
  "mainBinaryName": "RTMPFileStreamer",
  "version": "1.1.6",
  "identifier": "net.kre3.rtmpfilestreamer",
  "build": {
    "beforeDevCommand": "pnpm dev:renderer",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:renderer",
    "frontendDist": "../out/renderer-tauri"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; media-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.ico", "icons/icon.png", "icons/128x128.png"],
    "resources": []
  }
}
